+def _build_market_data_real(cfg: PipelineConfig,
+                             paths: OutputPaths) -> Dict[str, Any]:
+    """Real-data path: load Italian GME XLSX files via MarketDataLoader.
+
+    Slicing rules:
+      - pretrain window = the final `cfg.pretrain_months * 30` days of
+        the train_year (typically 2023).
+      - annual window  = the full eval_year (typically 2024). The number
+        of annual days is forced to match the calendar length of the
+        year (365 or 366 if leap) when cfg.days is the default 365.
+
+    Methodology notes for the paper:
+      - Prices are PUN MGP day-ahead values, which are the settlement
+        prices for arbitrage in the Italian market. MI-A1 prices are
+        loaded but not directly fed into MILP/PPO; they were already
+        used in Block 1 to calibrate the forecast-error distribution
+        whose parameters are passed in via --forecast-calibration-json.
+      - Flexibility-service prices remain synthetic, generated by
+        FlexibilityMarket from italian_market_config tariffs. The MSD
+        XLSX data validates the order of magnitude of these tariffs
+        (see Block 1 README) but is not yet wired into the per-hour
+        service catalogue. Full MSD price integration is a follow-up.
+      - Hours where PUN MGP is missing (a handful due to file format
+        edge cases) are forward-filled with the previous valid value;
+        affected hours are logged for transparency.
+    """
+    from market_data_loader import MarketDataLoader
+
+    pretrain_days = cfg.pretrain_months * 30
+    pretrain_hours = pretrain_days * 24
+
+    if cfg.verbose:
+        print(f"  Loading real Italian market data from {cfg.data_dir!r} "
+              f"(train_year={cfg.train_year}, eval_year={cfg.eval_year}, "
+              f"msd_zone={cfg.msd_zone!r})")
+
+    loader = MarketDataLoader(cfg.data_dir, msd_zone=cfg.msd_zone)
+    data = loader.load_all()
+    if cfg.verbose:
+        print(data.coverage_report())
+
+    # --- Sanity: train_year and eval_year must be present in PUN MGP ---
+    available_years = sorted(set(data.pun.index.year))
+    if cfg.train_year not in available_years:
+        raise ValueError(
+            f"--train-year={cfg.train_year} not in data ({available_years})")
+    if cfg.eval_year not in available_years:
+        raise ValueError(
+            f"--eval-year={cfg.eval_year} not in data ({available_years})")
+
+    # --- Slice the pretrain window (last `pretrain_days` of train_year) ---
+    train_pun = data.pun.loc[str(cfg.train_year), 'pun_mgp']
+    if len(train_pun) < pretrain_hours:
+        # Could be off by 1 due to the spring-forward DST hour: reindex to
+        # a clean hourly grid covering the train year and forward-fill.
+        full_train_idx = pd.date_range(
+            f"{cfg.train_year}-01-01 00:00",
+            f"{cfg.train_year}-12-31 23:00", freq="h")
+        train_pun = train_pun.reindex(full_train_idx).ffill().bfill()
+    if len(train_pun) < pretrain_hours:
+        raise ValueError(
+            f"train_year={cfg.train_year} has only {len(train_pun)} hours "
+            f"but pretrain window requires {pretrain_hours}h. Either "
+            f"reduce --pretrain-months or extend the data.")
+    pretrain_series = train_pun.iloc[-pretrain_hours:]
+
+    # --- Slice the annual window (full eval_year) ---
+    # Reindex to a clean hourly grid covering the entire eval year so the
+    # downstream code sees exactly 365*24 (or 366*24 for leap years) hours,
+    # absorbing any DST-related single-hour gap.
+    full_eval_idx = pd.date_range(
+        f"{cfg.eval_year}-01-01 00:00",
+        f"{cfg.eval_year}-12-31 23:00", freq="h")
+    annual_series = data.pun.loc[str(cfg.eval_year), 'pun_mgp']
+    annual_series = annual_series.reindex(full_eval_idx).ffill().bfill()
+
+    # --- Forward-fill any sporadic missing hours within the slices ---
+    def _ffill(series, label):
+        nan_before = int(series.isna().sum())
+        if nan_before > 0:
+            print(f"  WARNING: {nan_before} missing hours in {label} "
+                  f"window were forward-filled.")
+        return series.ffill().bfill()
+    pretrain_series = _ffill(pretrain_series, f"pretrain ({cfg.train_year})")
+    annual_series   = _ffill(annual_series,   f"annual ({cfg.eval_year})")
+
+    pretrain_prices = pretrain_series.to_numpy()
+    annual_prices   = annual_series.to_numpy()
+
+    # If the user did not override cfg.days, snap it to the actual length
+    # of the eval-year window. Otherwise honor the user's --days choice
+    # (clipped to the annual length to avoid out-of-range access).
+    annual_days = len(annual_prices) // 24
+    if cfg.days == 365 and annual_days != 365:
+        cfg.days = annual_days
+        annual_prices = annual_prices[: cfg.days * 24]
+    else:
+        cfg.days = min(cfg.days, annual_days)
+        annual_prices = annual_prices[: cfg.days * 24]
+
+    if cfg.verbose:
+        print(f"  Real-data slicing: pretrain={len(pretrain_prices)}h "
+              f"({pretrain_days}d from end of {cfg.train_year}), "
+              f"annual={len(annual_prices)}h ({cfg.days}d of {cfg.eval_year})")
+
+    total_hours = len(pretrain_prices) + len(annual_prices)
+
+    # --- Flexibility services: still synthetic, driven by FlexibilityMarket ---
+    flex_market = FlexibilityMarket(random_seed=cfg.seed,
+                                    flex_price_error_pct=cfg.flex_price_error_pct)
+    services = generate_flexibility_services(total_hours, flex_market)
+
+    # --- Persist the real prices we loaded for reproducibility ---
+    df = pd.DataFrame({
+        "hour": np.arange(total_hours),
+        "phase": (["pretrain"] * len(pretrain_prices)
+                  + ["annual"] * len(annual_prices)),
+        "datetime": np.concatenate(
+            [pretrain_series.index.astype('datetime64[ns]').to_numpy(),
+             annual_series.iloc[: cfg.days * 24].index
+             .astype('datetime64[ns]').to_numpy()]),
+        "price_eur_mwh": np.concatenate([pretrain_prices, annual_prices]),
+    })
+    df.to_csv(paths.data / "real_prices.csv", index=False)
+
+    return {
+        "pretrain_prices": pretrain_prices.tolist(),
+        "pretrain_services": services[:len(pretrain_prices)],
+        "annual_prices": annual_prices.tolist(),
+        "annual_services": services[len(pretrain_prices):],
+        "flex_market": flex_market,
+    }
+
 
